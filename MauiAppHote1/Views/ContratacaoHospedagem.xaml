<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHote1.Views.ContrataçãoHospedagem"
             Title="ContrataçãoHospedagem"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#222222">

    <VerticalStackLayout VerticalOptions="CenterAndExpand" Padding="20">
        <Label 
            Text="Calculo da Diaria"
            FontFamily="OswaldBold"
            FontSize="40"
            Padding="10"
            HorizontalTextAlignment="Center"
            TextColor="White" />

        <Frame Padding="10">
            <VerticalStackLayout>
                <Grid RowDefinitions="Auto, Auto"
                      ColumnDefinitions="*, *, 2*">

                    <Label Grid.Row="0" Grid.Column="0"
                       Text="Adultos:"/>

                    <Label Grid.Row="0" Grid.Column="1"
                       TextColor="white" 
                       Text="{Binding Value}"
                       BindingContext="{x:Reference stp_adultos}"/>

                    <Stepper Grid.Row="0" Grid.Column="2"
                             x:Name="stp_adultos"
                             Minimum="0"
                             Maximum="10"
                             Increment="1"/>

                    <Label Grid.Row="1" Grid.Column="0"
                       Text="Crianças:"
                       />

                    <Label Grid.Row="1" Grid.Column="1"
                           TextColor="white" 
                           Text="{Binding Value}"
                           BindingContext="{x:Reference stp_criancas}"/>

                    <Stepper Grid.Row="1" Grid.Column="2"
                             x:Name="stp_criancas"
                             Minimum="0"
                             Maximum="10"
                             Increment="1"/>
                </Grid>

                <Label Text="Escolha sua Suite"
                       FontFamily="OswaldBold"/>

                <Picker x:Name="pck_quarto"
                        Title="Selecione seu quarto" 
                        FontFamily="OswaldSemibold"/>

                <Frame Padding="18" Margin="10">
                    <VerticalStackLayout>
                        <Label Text="Periodo da estadia:" />
                        <HorizontalStackLayout>
                            <Label Text="Check-in:" 
                                   FontFamily="OswaldMedium"/>
                            <DatePicker x:Name="dtp_checkin" Format="dd/MM/yyyy"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout>
                             
                            <Label Text="Check-out:"
                                   FontFamily="OswaldMedium"/>
                            <DatePicker x:Name="dtp_checkout" Format="dd/MM/yyyy"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <VerticalStackLayout Spacing="15" Margin="0,10,0,0">
                    <Button Text="Avançar"
                            FontFamily="OswaldLight"
                            BackgroundColor="White"/>
                    <Button Text="Sobre"
                            BackgroundColor="White"
                            FontFamily="OswaldLight"
                            Clicked="OnSobreClicked"/>
                </VerticalStackLayout>


            </VerticalStackLayout>


        </Frame>
    </VerticalStackLayout>
</ContentPage>